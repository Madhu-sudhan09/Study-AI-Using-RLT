# ─────────────────────────────────────────
#  StudyAI Environment Configuration
# ─────────────────────────────────────────

# MongoDB Connection (replace with your MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/studyai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studyai

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (change this to a strong random string in production)
JWT_SECRET=studyai_super_secret_jwt_key_2024_change_in_production

# Anthropic API Key (stored securely on server - never exposed to client)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# CORS Origin (your frontend URL)
CORS_ORIGIN=http://localhost:3000
